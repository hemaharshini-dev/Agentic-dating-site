# Apify account token (server-side only). Never expose this as NEXT_PUBLIC_*.
APIFY_API_TOKEN=

# Actor IDs from the two Actors shown in the setup screenshots.
# Change these only if you choose different Actors and update the adapters.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper
APIFY_LINKEDIN_ACTOR_ID=harvestapi~linkedin-profile-posts

# Optional private profile database (Supabase): enable Anonymous Sign-ins,
# then run supabase/schema.sql in the Supabase SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI profile summaries (Groq). Keep this server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
